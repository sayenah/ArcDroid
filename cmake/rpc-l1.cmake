if(TARGET arcdroid_rpcmeasure_libretro AND ARCDROID_RPC_L1_VARIANTS)
  foreach(variant IN ITEMS sa_linear sa_hint sa_mirror off)
    set(l1_target arcdroid_rpcmeasure_l1_${variant}_libretro)
    arcdroid_add_libretro(${l1_target} FALSE arcdroid_core_test)
    target_compile_definitions(${l1_target} PRIVATE ARCDROID_TEST_FAULTS=1
      ARCDROID_TEST_API=1 ARCDROID_TEST_PLANS=1 ARCDROID_RPC_MEASUREMENT=1)
    target_sources(${l1_target} PRIVATE tests/hd_product_seed.c)
    if(variant STREQUAL "off")
      target_compile_definitions(${l1_target}_rpc PRIVATE ARCDROID_RPC_L1_GATE=0)
    else()
      if(variant STREQUAL "sa_linear")
        set(l1_gate 0)
      elseif(variant STREQUAL "sa_hint")
        set(l1_gate 1)
      else()
        set(l1_gate 2)
      endif()
      target_compile_definitions(${l1_target}_rpc PRIVATE ARCDROID_RPC_L1_SA_GATE=${l1_gate})
    endif()
    foreach(part IN ITEMS ${l1_target} ${l1_target}_rpc ${l1_target}_arculator)
      target_compile_options(${part} PRIVATE $<$<C_COMPILER_ID:GNU,Clang,AppleClang>:-fvisibility=hidden>)
    endforeach()
    if(WIN32)
      target_sources(${l1_target} PRIVATE tests/rpc_crash_locator.c)
    endif()
    if(ANDROID)
      set_target_properties(${l1_target} PROPERTIES OUTPUT_NAME ${l1_target}_android)
      target_link_options(${l1_target} PRIVATE "-Wl,-z,defs" "-Wl,-z,max-page-size=16384")
    endif()
  endforeach()
endif()
if(TARGET rpc_endpoint_test)
  foreach(kind IN ITEMS directed crosscheck poison)
    set(l1_test rpc_l1_${kind}_test)
    add_executable(${l1_test} tests/rpc_l1_test.c engine/rpc/rpc_scheduler.c)
    target_include_directories(${l1_test} PRIVATE engine/rpc engine/rpcemu/src libretro/include)
    target_compile_definitions(${l1_test} PRIVATE RELEASE_BUILD=1 ARCDROID_TEST_FAULTS=1)
    target_compile_options(${l1_test} PRIVATE -UNDEBUG -fno-strict-aliasing
      -include ${CMAKE_CURRENT_SOURCE_DIR}/engine/rpc/rpc_namespace.h)
    if(kind STREQUAL "crosscheck")
      target_compile_definitions(${l1_test} PRIVATE ARCDROID_RPC_CROSSCHECK=1)
      target_sources(${l1_test} PRIVATE engine/rpc/rpc_crosscheck.c)
    elseif(kind STREQUAL "poison")
      target_compile_definitions(${l1_test} PRIVATE ARCDROID_RPC_L1_POISON=1)
    endif()
    if(ARCDROID_SANITIZERS)
      target_link_libraries(${l1_test} PRIVATE arcdroid_sanitizer_compile arcdroid_sanitizer_link)
    endif()
    if(NOT ANDROID)
      add_test(NAME rpc-l1-${kind} COMMAND ${l1_test})
      # Local Debug ASan/UBSan worst 88.35 s: W4 requires twice that,
      # rounded up to a whole minute. Native Windows margin awaits CI.
      set_tests_properties(rpc-l1-${kind} PROPERTIES TIMEOUT 180)
    endif()
  endforeach()
endif()
